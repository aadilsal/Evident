# Copy to .env and fill in. .env is gitignored; never commit real values.

# LLM grouping (ADR-0007). Without it, analysis falls back to directory groups.
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-20b). EVIDENT_LLM=off disables the LLM.
EVIDENT_LLM_MODEL=
EVIDENT_LLM=

# Service (deploy/docker-compose.yml sets DATABASE_URL and REDIS_URL for you).
POSTGRES_PASSWORD=
EVIDENT_IP_SALT=
EVIDENT_RATE_LIMIT_PER_HOUR=
EVIDENT_JOB_TIMEOUT_S=

# Optional: fine-grained, public-read-only GitHub token for metadata calls (rate limits).
GITHUB_TOKEN=
