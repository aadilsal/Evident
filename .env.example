# Copy to .env and fill in. .env is gitignored; never commit real values.

# LLM grouping (ADR-0007). Without it, analysis falls back to directory groups.
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-20b). EVIDENT_LLM=off disables the LLM.
EVIDENT_LLM_MODEL=
EVIDENT_LLM=

# Service (deploy/docker-compose.yml sets DATABASE_URL and REDIS_URL for you).
POSTGRES_PASSWORD=
EVIDENT_IP_SALT=
EVIDENT_RATE_LIMIT_PER_HOUR=
EVIDENT_JOB_TIMEOUT_S=

# Optional: fine-grained, public-read-only GitHub token for metadata calls (rate limits).
GITHUB_TOKEN=

# Web frontend (ADR-0008): the site's exact origin(s), comma-separated; and its base URL for share links.
EVIDENT_CORS_ORIGINS=
EVIDENT_PUBLIC_URL=
# Optional limits for `evident share` uploads and "report a wrong edge".
EVIDENT_SHARE_TTL_DAYS=
EVIDENT_SHARE_MAX_BYTES=
EVIDENT_SHARE_LIMIT_PER_HOUR=
EVIDENT_REPORT_LIMIT_PER_HOUR=

# CLI: where `evident share` uploads (until the hosted API has a default).
EVIDENT_API_URL=

# web/ build (set in Vercel, not here): NEXT_PUBLIC_API_URL=https://api.<domain>
