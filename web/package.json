{
  "name": "evident-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prepare:data && next build",
    "build:bundle": "npm run build && node scripts/bundle.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "node scripts/tokens.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "prepare:data": "node scripts/sync-data.mjs",
    "check:generated": "node scripts/tokens.mjs --check && node scripts/gen-types.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@shikijs/langs": "^4.6.0",
    "@xyflow/react": "^12.12.1",
    "animejs": "^4.5.0",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
